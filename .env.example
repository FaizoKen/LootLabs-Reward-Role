# =====================================================================
# LootLabs Reward Role — environment configuration
# Copy this file to `.env` and fill in the values.
# =====================================================================

# Postgres connection string for this plugin.
DATABASE_URL=postgres://app:password@db:5432/lootlabs_reward_role

# Random secret used to verify the shared `rl_session` cookie issued by
# the Auth Gateway. MUST exactly match the gateway's SESSION_SECRET.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_me_with_the_gateway_session_secret

# Public URL where this plugin is reachable, including the path prefix.
# RoleLogic and Loot Labs both require HTTPS in production.
BASE_URL=https://plugin-rolelogic.faizo.net/lootlabs-reward-role

# Where the Auth Gateway is reachable from this container.
AUTH_GATEWAY_URL=http://auth-gateway:8090

# Optional: address the HTTP server binds to. Default 0.0.0.0:8088.
LISTEN_ADDR=0.0.0.0:8088

# Optional: log filter.
RUST_LOG=lootlabs_reward_role=info,tower_http=info
